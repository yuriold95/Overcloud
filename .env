# Copy to .env (git-ignored). Never commit real values.
ENV=local
LOG_LEVEL=INFO

# Local MongoDB from docker-compose (single-node replica set => transactions available)
MONGODB_URI='mongodb://localhost:27017/?replicaSet=rs0&directConnection=true'
MONGODB_DB=overclouded
MONGODB_USE_TRANSACTIONS=true

# Local dev auth: generate any long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
AUTH_MODE=dev
DEV_JWT_SECRET=ZUHYW7_-jJ5EnQIlm6OpB_Fu1Kw-ms_yYjI1SiKKoc3_7jDwxJfozT6mD2CFvsNl

# Deployed (Cognito) — filled by `make deploy` outputs, not secrets
# AUTH_MODE=cognito
# COGNITO_REGION=ap-south-1
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=

AWS_REGION_APP=ap-south-1
AWS_REGION_COH=us-east-1
AWS_REGION_SUSTAINABILITY=us-east-1
AWS_REGION_PRICING=us-east-1

# Deploy identity: a named profile from `aws configure sso` (never access keys in this file)
# AWS_PROFILE=overclouded-deployer
